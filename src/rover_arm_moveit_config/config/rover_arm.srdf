<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="rover_arm">
    <!-- SRDF for the v2 arm (rover_arm.xacro). The disable_collisions list is generated by
         moveit_setup_assistant's collisions_updater; regenerate it whenever the geometry changes:
         /opt/ros/jazzy/lib/moveit_setup_assistant/collisions_updater -\-urdf rover_arm.urdf.xacro
           -\-srdf rover_arm.srdf -\-output rover_arm.srdf -\-default -\-always -\-trials 20000
         The gripper has one actuated joint (right_finger_back_top_link_joint); the rest of the
         linkage are URDF mimic joints, listed in the group so it owns all finger links. -->
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->
    <group name="arm">
        <joint name="base_link_joint"/>
        <joint name="shoulder_link_joint"/>
        <joint name="elbow_link_joint"/>
        <joint name="wrist_link_joint"/>
        <joint name="palm_link_joint"/>
        <chain base_link="stand_link" tip_link="palm_link"/>
    </group>
    <group name="gripper">
        <joint name="left_finger_back_bottom_link_joint"/>
        <joint name="left_finger_back_top_link_joint"/>
        <joint name="left_finger_front_bottom_link_joint"/>
        <joint name="left_finger_front_top_link_joint"/>
        <joint name="left_finger_link_joint"/>
        <joint name="right_finger_back_bottom_link_joint"/>
        <joint name="right_finger_back_top_link_joint"/>
        <joint name="right_finger_front_bottom_link_joint"/>
        <joint name="right_finger_front_top_link_joint"/>
        <joint name="right_finger_link_joint"/>
    </group>
    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <!-- Named arm poses: used by MoveIt (RViz goal list) AND by real_arm_teleop_node
         (LB + A/B/X/Y). Converted from the v1 arm by matching the physical pose; drive the
         arm to the real pose and press LB + Start to print a replacement block. -->
    <!-- zero pose: arm straight out, horizontal -->
    <group_state name="home" group="arm">
        <joint name="base_link_joint" value="0"/>
        <joint name="elbow_link_joint" value="0"/>
        <joint name="palm_link_joint" value="0"/>
        <joint name="shoulder_link_joint" value="0"/>
        <joint name="wrist_link_joint" value="0"/>
    </group_state>
    <!-- folded: palm ~0.38 m forward, 0.32 m above the stand base -->
    <group_state name="stow" group="arm">
        <joint name="base_link_joint" value="0"/>
        <joint name="elbow_link_joint" value="2.3"/>
        <joint name="palm_link_joint" value="0"/>
        <joint name="shoulder_link_joint" value="-1.5"/>
        <joint name="wrist_link_joint" value="-0.8"/>
    </group_state>
    <!-- palm ~0.62 m forward, 0.59 m up, roughly level -->
    <group_state name="panel_ready" group="arm">
        <joint name="base_link_joint" value="0"/>
        <joint name="elbow_link_joint" value="-0.5"/>
        <joint name="palm_link_joint" value="0"/>
        <joint name="shoulder_link_joint" value="-0.6"/>
        <joint name="wrist_link_joint" value="1"/>
    </group_state>
    <!-- PLACEHOLDER: to the side, 0.31 m up. Record it over the real storage cache. -->
    <group_state name="cache_drop" group="arm">
        <joint name="base_link_joint" value="1.57"/>
        <joint name="elbow_link_joint" value="1.6"/>
        <joint name="palm_link_joint" value="0"/>
        <joint name="shoulder_link_joint" value="-1.3"/>
        <joint name="wrist_link_joint" value="0.4"/>
    </group_state>
    <!-- palm ~0.64 m forward, 0.17 m up, pointing down (re-record on the rover) -->
    <group_state name="ground_pick" group="arm">
        <joint name="base_link_joint" value="0"/>
        <joint name="elbow_link_joint" value="0.9"/>
        <joint name="palm_link_joint" value="0"/>
        <joint name="shoulder_link_joint" value="-0.7"/>
        <joint name="wrist_link_joint" value="0.9"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="right_finger_back_top_link_joint" value="-0.7"/>
    </group_state>
    <group_state name="closed" group="gripper">
        <joint name="right_finger_back_top_link_joint" value="0.45"/>
    </group_state>
    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="gripper" parent_link="palm_link" group="gripper" parent_group="arm"/>
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="stand_link"/>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_link" link2="elbow_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="stand_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="zed_camera_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="elbow_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="left_finger_back_bottom_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="left_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="left_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="left_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="left_finger_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="palm_link" reason="Adjacent"/>
    <disable_collisions link1="camera_mount_link" link2="right_finger_back_bottom_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="right_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="right_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="right_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="camera_mount_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="left_finger_back_bottom_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="left_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="left_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="left_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="left_finger_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="palm_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="right_finger_back_bottom_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="right_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="right_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="right_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="elbow_link" link2="wrist_link" reason="Adjacent"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="left_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="left_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="left_finger_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="palm_link" reason="Adjacent"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="right_finger_back_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="right_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="right_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="right_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_top_link" link2="left_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_top_link" link2="left_finger_link" reason="Adjacent"/>
    <disable_collisions link1="left_finger_back_top_link" link2="palm_link" reason="Adjacent"/>
    <disable_collisions link1="left_finger_back_top_link" link2="right_finger_back_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_top_link" link2="right_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_top_link" link2="right_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_top_link" link2="right_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_top_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="left_finger_back_top_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_bottom_link" link2="left_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_bottom_link" link2="left_finger_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_bottom_link" link2="palm_link" reason="Adjacent"/>
    <disable_collisions link1="left_finger_front_bottom_link" link2="right_finger_back_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_bottom_link" link2="right_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_bottom_link" link2="right_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_bottom_link" link2="right_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_bottom_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_top_link" link2="left_finger_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_top_link" link2="palm_link" reason="Adjacent"/>
    <disable_collisions link1="left_finger_front_top_link" link2="right_finger_back_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_top_link" link2="right_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_top_link" link2="right_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_top_link" link2="right_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_top_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="left_finger_front_top_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="palm_link" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="right_finger_back_bottom_link" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="right_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="right_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="palm_link" link2="right_finger_back_bottom_link" reason="Adjacent"/>
    <disable_collisions link1="palm_link" link2="right_finger_back_top_link" reason="Adjacent"/>
    <disable_collisions link1="palm_link" link2="right_finger_front_bottom_link" reason="Adjacent"/>
    <disable_collisions link1="palm_link" link2="right_finger_front_top_link" reason="Adjacent"/>
    <disable_collisions link1="palm_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="palm_link" link2="wrist_link" reason="Adjacent"/>
    <disable_collisions link1="right_finger_back_bottom_link" link2="right_finger_back_top_link" reason="Never"/>
    <disable_collisions link1="right_finger_back_bottom_link" link2="right_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="right_finger_back_bottom_link" link2="right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="right_finger_back_bottom_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="right_finger_back_top_link" link2="right_finger_front_bottom_link" reason="Never"/>
    <disable_collisions link1="right_finger_back_top_link" link2="right_finger_link" reason="Default"/>
    <disable_collisions link1="right_finger_back_top_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="right_finger_front_bottom_link" link2="right_finger_front_top_link" reason="Never"/>
    <disable_collisions link1="right_finger_front_bottom_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="right_finger_front_bottom_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="right_finger_front_top_link" link2="right_finger_link" reason="Default"/>
    <disable_collisions link1="right_finger_front_top_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="right_finger_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="zed_camera_link" reason="Never"/>
    <disable_collisions link1="stand_link" link2="zed_camera_link" reason="Adjacent"/>
    <!-- Added by hand ("User"): the gripper linkage touches itself near full closure and the
         fingertips close onto each other by design. The random sampling above misses these
         because they only happen at the very end of the gripper's travel. Keep them when
         regenerating (collisions_updater -\-keep). -->
    <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="User"/>
    <disable_collisions link1="right_finger_back_bottom_link" link2="right_finger_front_bottom_link" reason="User"/>
    <disable_collisions link1="right_finger_back_top_link" link2="right_finger_front_top_link" reason="User"/>
    <disable_collisions link1="left_finger_link" link2="right_finger_front_bottom_link" reason="User"/>
    <disable_collisions link1="left_finger_back_bottom_link" link2="left_finger_front_bottom_link" reason="User"/>
    <disable_collisions link1="left_finger_back_top_link" link2="left_finger_front_top_link" reason="User"/>
    <disable_collisions link1="left_finger_front_bottom_link" link2="right_finger_link" reason="User"/>
</robot>
