<?xml version="1.0"?>
<!-- Real-arm variant: the shared description (rover_arm.xacro) + the RoverArmHardware
     ros2_control block (AVATAR serial link to the ESP32). Used by arm_real.launch.py. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_arm">

  <!-- Motors to drive WITHOUT encoder feedback: "none", "all", or a comma-separated
       list of joint names, e.g. "wrist_link_joint,palm_link_joint".
       Set from the launch file: arm_real.launch.py open_loop_joints:=all -->
  <xacro:arg name="open_loop_joints" default="none"/>
  <!-- Motor tuning, overridable from the launch file (arm_real.launch.py ff_gain:=... pwm_deadband:=...). -->
  <xacro:arg name="ff_gain" default="100.0"/>
  <xacro:arg name="pwm_deadband" default="0.0"/>

  <xacro:include filename="$(find rover_arm_description)/urdf/rover_arm.xacro"/>

  <xacro:macro name="joint_interface" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
  </xacro:macro>

  <ros2_control name="RoverArmHardware" type="system">
    <hardware>
      <plugin>rover_arm_hardware/RoverArmHardware</plugin>
      <xacro:property name="serial_port" value="/dev/ttyACM0"/>
      <xacro:property name="baud_rate" value="115200"/>
      <param name="serial_port">${serial_port}</param>      <!-- NOT used by RoverArmHardware: the port is set with arm_real.launch.py serial_port:=... -->
      <param name="baud_rate">${baud_rate}</param>
      <param name="kp">40.0</param>
      <param name="ki">5.0</param>
      <param name="pwm_limit">255.0</param>
      <!-- PWM per rad/s of motor velocity: the whole command in open loop, the feed-forward
           in closed loop. Tune on the bench in open loop first. -->
      <param name="ff_gain">$(arg ff_gain)</param>
      <!-- PWM below which the motors don't move. Small commands are scaled up past it
           while a motion is commanded. 0 = off; measure on the bench (open loop). -->
      <param name="pwm_deadband">$(arg pwm_deadband)</param>
      <!-- Gripper: PWM cap = grip force on an object. STALL fault off for the gripper
           (1 = on), because squeezing an object stalls the motor by design. -->
      <param name="gripper_pwm_limit">180.0</param>
      <param name="gripper_stall_fault">0</param>
      <param name="open_loop_joints">$(arg open_loop_joints)</param>
      <!-- Closed loop: motors get 0 PWM if /enc_angles is older than this. -->
      <param name="encoder_timeout_s">0.25</param>
      <!-- Startup: wait this long for the first /enc_angles before failing. -->
      <param name="encoder_wait_s">10.0</param>
      <!-- Fault detection (closed-loop motors; 0 disables a check). A fault latches the
           motor at 0 PWM until an std_msgs/Empty is published on /arm_hardware/clear_faults -->
      <param name="runaway_time_s">0.5</param>   <!-- driven one way, moving the other way -->
      <param name="stall_time_s">1.0</param>     <!-- commanded, >= 50% PWM, not moving -->
      <param name="max_jump_deg">15.0</param>    <!-- impossible jump between two readings -->
    </hardware>

    <!-- Order matters (RoverArmHardware maps joints to motors by position). The gripper's
         other linkage joints are passive mimic joints: robot_state_publisher and MoveIt
         compute them from the URDF <mimic> tags, so they're not listed here. -->
    <xacro:joint_interface joint_name="base_link_joint" />
    <xacro:joint_interface joint_name="shoulder_link_joint" />
    <xacro:joint_interface joint_name="elbow_link_joint" />
    <xacro:joint_interface joint_name="wrist_link_joint" />
    <xacro:joint_interface joint_name="palm_link_joint" />
    <xacro:joint_interface joint_name="right_finger_back_top_link_joint" />
  </ros2_control>
</robot>
