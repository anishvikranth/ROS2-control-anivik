<?xml version="1.0"?>
<!-- Gazebo variant of the arm: the shared description (rover_arm.xacro) + a world link +
     Gazebo's ros2_control. Used by gazebo.launch.py, arm_real_sim.launch.py (velocity, /gz)
     and, with use_gazebo_ros2_control:=false, by the MoveIt demo. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_arm">

  <xacro:arg name="use_gazebo_ros2_control" default="true"/>
  <!-- position (gazebo.launch.py) or velocity (arm_real_sim.launch.py, driven by virtual_esp.py) -->
  <xacro:arg name="gz_command_interface" default="position"/>
  <xacro:property name="gz_cmd_velocity" value="${'$(arg gz_command_interface)' == 'velocity'}"/>
  <!-- Namespace + controller file for Gazebo's own controller manager (arm_real_sim uses /gz). -->
  <xacro:arg name="gz_namespace" default=""/>
  <xacro:arg name="gz_controllers_file" default="ros2_controllers_sim.yaml"/>

  <xacro:include filename="$(find rover_arm_description)/urdf/rover_arm.xacro"/>

  <link name="world"/>
  <joint name="world_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="stand_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:if value="$(arg use_gazebo_ros2_control)">
    <xacro:macro name="gz_joint" params="name lower upper">
      <joint name="${name}">
        <xacro:if value="${gz_cmd_velocity}">
          <command_interface name="velocity"/>
        </xacro:if>
        <xacro:unless value="${gz_cmd_velocity}">
          <command_interface name="position">
            <param name="min">${lower}</param>
            <param name="max">${upper}</param>
          </command_interface>
        </xacro:unless>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <!-- Passive gripper linkage: follows right_finger_back_top_link_joint through the
         URDF <mimic> tags (ros2_control 4.x style: mimic="true", no command interface). -->
    <xacro:macro name="gz_mimic" params="name">
      <joint name="${name}" mimic="true">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:gz_joint name="base_link_joint" lower="-1.570795" upper="1.570795"/>
      <xacro:gz_joint name="shoulder_link_joint" lower="-1.570795" upper="0.3927"/>
      <xacro:gz_joint name="elbow_link_joint" lower="-3.141593" upper="3.141593"/>
      <xacro:gz_joint name="wrist_link_joint" lower="-1.570795" upper="1.570795"/>
      <xacro:gz_joint name="palm_link_joint" lower="-1.570796" upper="1.570796"/>  <!-- matches the URDF limit -->
      <!-- the gripper's one actuated joint -->
      <xacro:gz_joint name="right_finger_back_top_link_joint" lower="-0.785398" upper="0.523598"/>
      <xacro:gz_mimic name="right_finger_back_bottom_link_joint"/>
      <xacro:gz_mimic name="right_finger_front_bottom_link_joint"/>
      <xacro:gz_mimic name="right_finger_front_top_link_joint"/>
      <xacro:gz_mimic name="right_finger_link_joint"/>
      <xacro:gz_mimic name="left_finger_back_top_link_joint"/>
      <xacro:gz_mimic name="left_finger_back_bottom_link_joint"/>
      <xacro:gz_mimic name="left_finger_front_bottom_link_joint"/>
      <xacro:gz_mimic name="left_finger_front_top_link_joint"/>
      <xacro:gz_mimic name="left_finger_link_joint"/>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <ros>
          <namespace>$(arg gz_namespace)</namespace>
        </ros>
        <parameters>$(find rover_arm_description)/config/$(arg gz_controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- No Sensors / Physics systems here: worlds/world.sdf provides them. Adding a second
       Sensors system crashes Gazebo (duplicate render scene). -->
</robot>
