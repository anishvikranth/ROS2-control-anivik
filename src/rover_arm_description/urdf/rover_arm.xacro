  </joint>
  <joint name="zed_camera_link_joint" type="fixed">
    <origin xyz="0.052553 -0.000162 0" rpy="0 0 0" />
    <parent link="stand_link" />
    <child link="zed_camera_link" />
  </joint>
  <!-- Sensors -->
  <gazebo reference="camera_mount_link">
    <sensor name="camera_mount_link_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>/gripper/camera</topic>
      <pose>0 0 0.01115 0 0 0</pose>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="zed_camera_link">
    <sensor name="zed_camera_link_sensor" type="rgbd">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <topic>/zed/zed_node/image</topic>
      <gz_frame_id>zed_camera_link</gz_frame_id>
      <camera>
        <!-- 110 degree horizontal FOV in radians -->
        <horizontal_fov>1.91986</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>20.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
</robot>