  <!-- Arm joint limits: the <limit> lower/upper below are HARD STOPS, 10 deg outside the
       ranges the arm actually uses. The working (soft) limits are in
       rover_arm_moveit_config/config/joint_limits.yaml (MoveIt, RViz sliders) and
       real_arm_teleop_node.cpp. rover_arm_sim.xacro's command min/max match them, but
       gz_ros2_control doesn't enforce those. In Gazebo's DART engine a velocity-driven joint
       driven onto its stop could stay stuck there; the 10 deg margin keeps MoveIt's plans
       clear of it. -->
  <!-- Joints. Arm efforts are the CAD motor torques (from the v1 export); 10 Nm everywhere
       was too weak to lift the arm in a physics engine that enforces effort limits. -->
  <joint name="base_link_joint" type="revolute">
    <origin xyz="-0.000162 -0.000166 0.073" rpy="0 0 0" />
    <parent link="stand_link" />
    <child link="base_link" />
    <axis xyz="0 0 1" />
    <limit effort="34.32" velocity="1" lower="-1.745329" upper="1.745329" />
    <!-- friction was 75 Nm: more than the joint's 34 Nm effort, so under DART the base could
         never turn. The real base is held by its motor/gearbox, not by joint friction. -->
    <dynamics friction="1.0" damping="1.0" />
  </joint>
