<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>rover_arm_description</name>
  <version>0.0.0</version>

  <description>
    Robot description, simulation and control package for the rover arm.
  </description>

  <maintainer email="paiananth0838@gmail.com">ananth</maintainer>
  <license>TODO: License declaration</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS -->
  <depend>rclcpp</depend>

  <!-- Robot Description -->
  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>

  <!-- Messages -->
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>controller_manager_msgs</depend>

  <!-- ros2_control (runtime) -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>

  <!-- Simulation (gazebo.launch.py, arm_real_sim.launch.py) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>shape_msgs</exec_depend>

  <!-- MoveIt -->
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>

  <depend>rover_arm_hardware</depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
