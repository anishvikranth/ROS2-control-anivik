    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="137.300003" lower="-1.5708" upper="0.3927" velocity="1"/>
  </joint>
  <joint name="wrist_link_joint" type="revolute">
    <origin rpy="1.570796 -1.570796 0" xyz="0.266997 -0.000647 0.102497"/>
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="27.459999" lower="-1.570795" upper="1.570795" velocity="1"/>
  </joint>
  <joint name="zed_camera_link_joint" type="fixed">
    <origin rpy="0 0 1.570796" xyz="-0.000054 -0.052442 -0.01515"/>
    <parent link="stand_link"/>
    <child link="zed_camera_link"/>
  </joint>
  <!-- Sensors -->
  <gazebo reference="camera_mount_link">
    <sensor name="camera_mount_link_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>/gripper_camera/image</topic>
      <pose>0.035906 -0.000442 -0.0135 0 0 0</pose>
      <camera>
        <horizontal_fov>0.959931</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="zed_camera_link">
    <sensor name="zed_camera_link_sensor" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <topic>/zed/zed_node/rgb/color/rect/image</topic>
      <pose>0.000442 0.035906 -0.0135 0 0 0</pose>
      <camera>
        <horizontal_fov>1.919862</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20</far>
        </clip>
      </camera>
      <depth_camera>
        <output>
          <type>depth</type>
        </output>
      </depth_camera>
    </sensor>
  </gazebo>
  <!-- 2. Add a joint connecting a link from the body to the root link of the arm -->
  <joint name="stand_link_joint" type="fixed">
    <parent link="chassis_link"/>
    <!-- Link inside rover_body.xacro -->
    <child link="stand_link"/>
    <!-- Link inside rover_arm.xacro -->
    <origin rpy="0 0 0" xyz="0.15 0.0 0.0"/>
    <!-- Mounting position on chassis -->
  </joint>
</robot>
