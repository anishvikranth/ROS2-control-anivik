<?xml version="1.0" ?>
<sdf version="1.7">
    <world name="empty_world">
        <!-- 1. SUN / LIGHT SOURCE -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        
        <!-- 2. GROUND PLANE -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ========================================================= -->
        <!-- 3. ADD YOUR ARUCO MARKERS HERE (INSIDE <world>)           -->
        <!-- ========================================================= -->

        <!-- Add Marker 0 -->
        <include>
            <uri>model://marker_0</uri>
            <name>target_marker_0</name>
            <!-- Pose format: <pose>X Y Z Roll Pitch Yaw</pose> -->
            <pose>5.0 0.0 0.25 0 0 0</pose> 
        </include>

        <!-- Add Marker 1  -->
        <include>
            <uri>model://marker_1</uri>
            <name>target_marker_1</name>
            <pose>9.0 -1.0 0.25 0 0 -0.95</pose> 
        </include>

        <!--- Adding marker2-->
        <include>
            <uri>model://marker_2  </uri>
            <name>marker2         </name>
            <pose> 15.0 2.0 0.25 0 0 1.12  </pose> 
        </include>
    </world>
</sdf>