    <sensor name="zed_imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/zed/imu/data</topic>
      <gz_frame_id>zed_camera_link</gz_frame_id>
      <imu>
        <angular_velocity>
